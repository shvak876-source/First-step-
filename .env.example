# ===== כתובת האתר (בלי / בסוף) =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Supabase (Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# סודי! לשימוש בשרת בלבד (webhook, קישורים חתומים). לעולם לא עם NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# שם ה-bucket הפרטי של הסרטונים
SUPABASE_VIDEO_BUCKET=course-videos

# ===== Stripe (Developers → API keys / Webhooks) =====
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== חשבוניות – Morning / חשבונית ירוקה (אופציונלי) =====
# none = ללא הפקת מסמך (רק קבלת Stripe – לא מספיקה לחוק הישראלי!)
# greeninvoice = הפקת חשבונית מס-קבלה / קבלה אוטומטית
INVOICE_PROVIDER=none
GREENINVOICE_API_KEY_ID=
GREENINVOICE_API_KEY_SECRET=
# https://sandbox.d.greeninvoice.co.il/api/v1 לבדיקות, https://api.greeninvoice.co.il/api/v1 לייצור
GREENINVOICE_API_URL=https://sandbox.d.greeninvoice.co.il/api/v1
# 320 = חשבונית מס/קבלה (עוסק מורשה/חברה), 400 = קבלה (עוסק פטור)
GREENINVOICE_DOCUMENT_TYPE=400

# ===== אימייל ללקוח עם פרטי העסקה (Resend) =====
# https://resend.com → API Keys. יש לאמת את הדומיין שלכם ב-Resend כדי לשלוח ממנו.
RESEND_API_KEY=
# למשל: "הצעד הראשון <orders@your-domain.co.il>"
EMAIL_FROM=
# לאן יגיעו תשובות של לקוחות (אופציונלי)
EMAIL_REPLY_TO=
